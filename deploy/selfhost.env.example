# Copy to deploy/selfhost.env. No passwords or tunnel tokens belong here.
# Replace with the reviewed release's full local image ID or registry digest.
GITPULSE_IMAGE=gitpulse:selfhost-REPLACE_WITH_REVIEWED_COMMIT
GITPULSE_WEB_PORT=3017
GITPULSE_ORIGIN=https://gitpulse.tmcsolutions-org.net
# Relative paths resolve from deploy/, where the Compose file lives.
GITPULSE_SECRETS_DIR=../artifacts/selfhost-secrets
