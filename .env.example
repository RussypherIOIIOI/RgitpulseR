# Local demo defaults. Next.js reads .env.local; CLI reads process environment.
DATABASE_URL=postgresql://gitpulse:local-demo-only@127.0.0.1:55440/gitpulse_demo
GITPULSE_MODE=demo
GITPULSE_REPO=example/observatory
GITPULSE_REFRESH_ENABLED=false
GITPULSE_ORIGIN=http://localhost:3017
# Generate a random key of at least 32 characters; never use a NEXT_PUBLIC variable.
GITPULSE_REFRESH_TOKEN=
# Optional read-only GitHub token, used only in LIVE mode.
GITHUB_TOKEN=
